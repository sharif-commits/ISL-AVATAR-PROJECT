cat > .gitignore << 'EOF'
# Model weights and large binary assets
*.pth
*.pth.tar
*.pkl
*.npz

# Rendered/generated outputs (regenerable, large)
skinning/output/
skinning/src/output/
skinning/src/videos/
Skeletonization/smplx_models/

# Dataset frames/videos (large, regenerable or too big for git)
dataset/Apple/
*.jpg
*.mp4
*.zip
*.json

# SMPL/SMPL-X model files specifically (redundant safety net)
smplx/
**/human_model_files/

# Python
__pycache__/
*.pyc
EOF